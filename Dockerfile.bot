FROM node:22-bookworm-slim AS deps

# Build tools only in this stage, in case a native module (@discordjs/opus) has no prebuilt binary
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Exactly the versions in package-lock.json
COPY bot/package.json bot/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-bookworm-slim

# Only 'requests' is needed for the Python helpers — WHISPER_ENDPOINT routes transcription to the
# whisper container, so openai-whisper (and PyTorch, ~2 GB) are never used here.
# For local dev without Docker, install the full requirements.txt instead.
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  ffmpeg \
  python3 python3-requests \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY bot/ ./

# Runtime directories the bot writes to; everything else stays read-only for the bot user
RUN mkdir -p audio logs recordings && chown -R node:node audio logs recordings

USER node
ENV NODE_ENV=production PYTHON=python3

CMD ["node", "src/bot.js"]
